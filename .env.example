# Base de datos (Neon). DATABASE_URL es la conexión agrupada (pooled);
# DATABASE_URL_UNPOOLED es la conexión directa que usa Prisma para migraciones.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# DeepSeek (modelos de IA, vía @ai-sdk/deepseek)
DEEPSEEK_API_KEY=

# Resend (correo entrante y saliente)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Langfuse (observabilidad)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
