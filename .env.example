# Base de datos (Neon). DATABASE_URL es la conexión agrupada (pooled);
# DATABASE_URL_UNPOOLED es la conexión directa que usa Prisma para migraciones.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# DeepSeek (modelos de IA, vía @ai-sdk/deepseek)
DEEPSEEK_API_KEY=
# Modelo para la extracción estructurada de facturas (opcional; por defecto deepseek-chat)
DEEPSEEK_EXTRACTION_MODEL=

# OpenAI (visión para imágenes y PDF escaneados en la extracción, vía @ai-sdk/openai)
OPENAI_API_KEY=
# Modelo de visión (opcional; por defecto gpt-4o-mini)
OPENAI_VISION_MODEL=

# Resend (correo entrante y saliente)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL_ID=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_PHONE=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Langfuse (observabilidad)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Composio (Gmail). Los tokens OAuth viven en Composio, no en Pacta.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_ID=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_TOOLKIT_VERSION_GMAIL=20251027_00
APP_URL=http://localhost:3000

# Cloudflare R2 — bucket Monark (`monark-media`). Las capturas van a pacta/invoices/...
R2_ACCOUNT_ID=336fc3046e47821b89a1647a3387a537
R2_BUCKET=monark-media
R2_ENDPOINT=https://336fc3046e47821b89a1647a3387a537.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-93e729bb52a7484eb99df64ce8ba41bf.r2.dev
R2_PREFIX=pacta/invoices
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
