// Esquema compartido. Identidad de login: Clerk.
// `Organization.id` = Clerk `org_...` (organizationId en InvoiceContext).
// `User.id` = Clerk `user_...` (actor_id en auditoría / decisiones).
// Toda consulta de negocio se acota por organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum MembershipRole {
  admin
  member
}

/// Espacio de trabajo. Aísla facturas, contratos y políticas.
model Organization {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships      OrganizationMembership[]
  gmailConnections GmailConnection[]
  gmailMessages    GmailInboundMessage[]
  documents        Document[]

  // Vertical B
  suppliers             Supplier[]
  paymentPolicies       PaymentPolicy[]
  paymentAuthorizations PaymentAuthorization[]
  paymentDecisions      PaymentDecision[]
  approvalRequests      ApprovalRequest[]
  bankImportBatches     BankImportBatch[]
  bankTransactions      BankTransaction[]
  auditEvents           AuditEvent[]

  @@map("organizations")
}

model User {
  id          String   @id
  email       String
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships      OrganizationMembership[]
  gmailConnections GmailConnection[]

  @@index([email])
  @@map("users")
}

/// Relación User ↔ Organization. Un usuario solo opera dentro de orgs a las que pertenece.
model OrganizationMembership {
  userId         String         @map("user_id")
  organizationId String         @map("organization_id")
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  approvalPermission ApprovalPermission?

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Vertical B — Payment Autopilot (docs/plans/developer-b-payment-decisions.md)
// Importes: unidades menores enteras (int4, máx. ~21.4M USD); moneda ISO 4217.
// Actores (`*By`, `actorId`): Clerk `user_...` como texto, sin FK, para que la
// auditoría sobreviva a la baja de un usuario.
//
// Garantías en SQL: Prisma 6 no expresa CHECK, índices únicos parciales ni
// triggers, así que viven en la migración `20261017163245_add_payment_autopilot_tables`
// y se documentan con `@db-guarantee` en cada modelo. Prisma las ignora al
// comparar (no las borra), pero si cambias un modelo marcado, actualiza su SQL.
// ---------------------------------------------------------------------------

enum PaymentAuthorizationScope {
  one_time
  recurring
}

enum PaymentAuthorizationStatus {
  active
  revoked
  consumed
}

enum PaymentFrequency {
  weekly
  monthly
  quarterly
  yearly
}

enum PaymentDecisionOutcome {
  approved
  blocked
  requires_approval
}

enum PaymentDecisionSource {
  automatic
  human
}

enum ApprovalRequestStatus {
  pending
  approved
  rejected
  cancelled
}

/// Catálogo de proveedores. Estar en el catálogo NO implica autorización.
model Supplier {
  id                    String   @id @default(cuid())
  organizationId        String   @map("organization_id")
  name                  String
  normalizedName        String   @map("normalized_name")
  beneficiaryAccountRef String?  @map("beneficiary_account_ref") // informativa; la autorización manda
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization     Organization           @relation(fields: [organizationId], references: [id])
  authorizations   PaymentAuthorization[]
  decisions        PaymentDecision[]
  bankTransactions BankTransaction[]

  @@unique([organizationId, normalizedName])
  @@map("suppliers")
}

/// Política versionada. Cada cambio crea una versión nueva; nunca se edita una existente.
/// @db-guarantee CHECK payment_policies_amounts_check: version > 0, límite y presupuesto >= 0, moneda ^[A-Z]{3}$.
model PaymentPolicy {
  id                     String   @id @default(cuid())
  organizationId         String   @map("organization_id")
  version                Int
  autoApprovalLimitMinor Int      @map("auto_approval_limit_minor")
  monthlyBudgetMinor     Int      @map("monthly_budget_minor")
  currency               String   @db.Char(3)
  effectiveFrom          DateTime @map("effective_from") @db.Timestamptz(6)
  createdBy              String   @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, version])
  @@map("payment_policies")
}

/// Autorización explícita otorgada por una persona. Cubre una factura solo si coinciden
/// proveedor, cuenta, moneda, monto máximo, alcance y vigencia.
/// @db-guarantee CHECK payment_authorizations_terms_check: monto máximo > 0, moneda ^[A-Z]{3}$,
///   validUntil >= validFrom, frecuencia obligatoria si recurring y null si one_time.
model PaymentAuthorization {
  id                      String                     @id @default(cuid())
  organizationId          String                     @map("organization_id")
  supplierId              String                     @map("supplier_id")
  beneficiaryAccountRef   String                     @map("beneficiary_account_ref")
  currency                String                     @db.Char(3)
  maxAmountMinor          Int                        @map("max_amount_minor")
  scope                   PaymentAuthorizationScope
  frequency               PaymentFrequency? // obligatoria si scope = recurring
  validFrom               DateTime                   @map("valid_from") @db.Date
  validUntil              DateTime                   @map("valid_until") @db.Date
  status                  PaymentAuthorizationStatus @default(active)
  authorizedBy            String                     @map("authorized_by")
  sourceApprovalRequestId String?                    @map("source_approval_request_id")
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt               DateTime?                  @map("revoked_at") @db.Timestamptz(6)
  revokedBy               String?                    @map("revoked_by")

  organization Organization @relation(fields: [organizationId], references: [id])
  supplier     Supplier     @relation(fields: [supplierId], references: [id])

  @@index([organizationId, supplierId, status])
  @@map("payment_authorizations")
}

/// Permisos de pago por usuario. Sin fila = sin permisos. Solo `admin` los edita.
/// @db-guarantee CHECK approval_permissions_limit_check: si canApprove, approvalLimitMinor no null y > 0;
///   si no, approvalLimitMinor null (no hay aprobadores ilimitados).
model ApprovalPermission {
  userId             String   @map("user_id")
  organizationId     String   @map("organization_id")
  canApprove         Boolean  @default(false) @map("can_approve")
  approvalLimitMinor Int?     @map("approval_limit_minor") // obligatorio si canApprove
  canManagePolicies  Boolean  @default(false) @map("can_manage_policies")
  grantedBy          String   @map("granted_by")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@id([userId, organizationId])
  @@map("approval_permissions")
}

/// Cada PaymentDecision validada. Solo inserción: una reevaluación crea otra fila.
/// @db-guarantee CHECK payment_decisions_actor_check: automatic => actorId null;
///   human => actorId y approvalRequestId no null.
/// @db-guarantee CHECK payment_decisions_approved_check: approved => policyVersion, amountMinor y currency no null.
/// @db-guarantee UNIQUE parcial payment_decisions_one_approved_per_invoice: (organizationId, invoiceId)
///   WHERE decision = 'approved' — una factura se aprueba y reserva presupuesto a lo sumo una vez.
/// @db-guarantee TRIGGER payment_decisions_append_only: rechaza UPDATE y DELETE.
model PaymentDecision {
  id                String                 @id @default(cuid())
  organizationId    String                 @map("organization_id")
  invoiceId         String                 @map("invoice_id") // FK pendiente hasta que A cree `invoices`
  supplierId        String?                @map("supplier_id")
  invoiceNumber     String?                @map("invoice_number")
  amountMinor       Int?                   @map("amount_minor")
  currency          String?                @db.Char(3)
  decision          PaymentDecisionOutcome
  decisionSource    PaymentDecisionSource  @map("decision_source")
  reasonCodes       Json                   @map("reason_codes")
  rulesEvaluated    Json                   @map("rules_evaluated")
  payload           Json // PaymentDecision completa validada por Zod
  policyVersion     Int?                   @map("policy_version")
  actorId           String?                @map("actor_id")
  approvalRequestId String?                @map("approval_request_id") // solicitud que resuelve (decisión humana)
  evaluatedAt       DateTime               @map("evaluated_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  organization      Organization     @relation(fields: [organizationId], references: [id])
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  resolvesRequest   ApprovalRequest? @relation("ApprovalResolution", fields: [approvalRequestId], references: [id])
  triggeredApproval ApprovalRequest? @relation("ApprovalTrigger")

  @@index([organizationId, invoiceId])
  @@index([organizationId, supplierId, invoiceNumber])
  @@index([organizationId, decision, evaluatedAt])
  @@map("payment_decisions")
}

/// Bandeja de intervención humana.
/// @db-guarantee UNIQUE parcial approval_requests_one_pending_per_invoice: (organizationId, invoiceId)
///   WHERE status = 'pending'.
model ApprovalRequest {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  invoiceId      String                @map("invoice_id")
  decisionId     String                @unique @map("decision_id") // decisión que escaló
  status         ApprovalRequestStatus @default(pending)
  requestedAt    DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedAt     DateTime?             @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?               @map("resolved_by")
  comment        String?

  organization Organization      @relation(fields: [organizationId], references: [id])
  decision     PaymentDecision   @relation("ApprovalTrigger", fields: [decisionId], references: [id])
  resolutions  PaymentDecision[] @relation("ApprovalResolution")

  @@index([organizationId, status, requestedAt])
  @@map("approval_requests")
}

/// Lote de importación CSV.
model BankImportBatch {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  fileName       String   @map("file_name")
  rowCount       Int      @map("row_count")
  importedBy     String   @map("imported_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  transactions BankTransaction[]

  @@index([organizationId, createdAt])
  @@map("bank_import_batches")
}

/// Movimiento ficticio importado de CSV. Historial, no autorización ni presupuesto.
model BankTransaction {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  importBatchId  String   @map("import_batch_id")
  supplierId     String?  @map("supplier_id")
  postedOn       DateTime @map("posted_on") @db.Date
  amountMinor    Int      @map("amount_minor") // con signo: negativo = salida
  currency       String   @db.Char(3)
  description    String
  externalRef    String?  @map("external_ref")
  fingerprint    String // hash de fecha + monto + descripción, para omitir repetidos
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id])
  importBatch  BankImportBatch @relation(fields: [importBatchId], references: [id])
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])

  @@unique([organizationId, fingerprint])
  @@unique([organizationId, externalRef])
  @@index([organizationId, supplierId, postedOn])
  @@map("bank_transactions")
}

/// Rastro append-only. actorId null = sistema.
/// @db-guarantee TRIGGER audit_events_append_only: rechaza UPDATE y DELETE.
model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  eventType      String   @map("event_type")
  actorId        String?  @map("actor_id")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

enum GmailConnectionStatus {
  pending
  active
  failed
  expired
  revoked
}

enum GmailInboundProcessingStatus {
  received
  processing
  processed
  failed
  ignored
}

/// Buzón Gmail de la organización. Tokens en Composio; aquí solo ids y estado.
model GmailConnection {
  id                         String                 @id
  organizationId             String                 @map("organization_id")
  connectedByUserId          String                 @map("connected_by_user_id")
  composioUserId             String                 @map("composio_user_id")
  composioConnectedAccountId String                 @unique @map("composio_connected_account_id")
  composioAuthConfigId       String                 @map("composio_auth_config_id")
  composioTriggerId          String?                @unique @map("composio_trigger_id")
  emailAddress               String?                @unique @map("email_address")
  alias                      String?
  status                     GmailConnectionStatus
  connectedAt                DateTime?              @map("connected_at") @db.Timestamptz(6)
  revokedAt                  DateTime?              @map("revoked_at") @db.Timestamptz(6)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connectedBy  User                  @relation(fields: [connectedByUserId], references: [id], onDelete: Restrict)
  messages     GmailInboundMessage[]

  @@index([organizationId])
  @@map("gmail_connections")
}

/// Ingesta de un correo. Unicidad por buzón + message id de Gmail.
model GmailInboundMessage {
  id                 String                        @id
  organizationId     String                        @map("organization_id")
  gmailConnectionId  String                        @map("gmail_connection_id")
  composioEventId    String                        @unique @map("composio_event_id")
  gmailMessageId     String                        @map("gmail_message_id")
  gmailThreadId      String?                       @map("gmail_thread_id")
  sender             String?
  subject            String?
  receivedAt         DateTime                      @map("received_at") @db.Timestamptz(6)
  processingStatus   GmailInboundProcessingStatus  @map("processing_status")
  invoiceId          String?                       @map("invoice_id")
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection   GmailConnection @relation(fields: [gmailConnectionId], references: [id], onDelete: Restrict)
  documents    Document[]

  @@unique([gmailConnectionId, gmailMessageId])
  @@index([organizationId, receivedAt])
  @@map("gmail_inbound_messages")
}

enum DocumentSource {
  email_body
  invoice_document
}

/// Original privado (cuerpo o adjunto). No implica una decisión de pago.
model Document {
  id                    String         @id
  organizationId        String         @map("organization_id")
  gmailInboundMessageId String         @map("gmail_inbound_message_id")
  fileRef               String         @map("file_ref")
  publicUrl             String         @map("public_url")
  mimeType              String         @map("mime_type")
  sha256                String
  originalFilename      String?        @map("original_filename")
  source                DocumentSource
  byteSize              Int            @map("byte_size")
  receivedAt            DateTime       @map("received_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inboundMessage GmailInboundMessage @relation(fields: [gmailInboundMessageId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([gmailInboundMessageId])
  @@map("documents")
}
