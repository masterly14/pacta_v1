// Esquema compartido. Identidad de login: Clerk.
// `Organization.id` = Clerk `org_...` (organizationId en InvoiceContext).
// `User.id` = Clerk `user_...` (actor_id en auditoría / decisiones).
// Toda consulta de negocio se acota por organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum MembershipRole {
  admin
  member
}

/// Espacio de trabajo. Aísla facturas, contratos y políticas.
model Organization {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships      OrganizationMembership[]
  gmailConnections GmailConnection[]
  gmailMessages    GmailInboundMessage[]
  documents        Document[]
  documentGroups   DocumentGroup[]
  ignoredItems     IgnoredInboundItem[]

  // Vertical B
  suppliers              Supplier[]
  paymentPolicies        PaymentPolicy[]
  paymentAuthorizations  PaymentAuthorization[]
  paymentDecisions       PaymentDecision[]
  approvalRequests       ApprovalRequest[]
  bankImportBatches      BankImportBatch[]
  bankTransactions       BankTransaction[]
  auditEvents            AuditEvent[]
  invoices               Invoice[]
  notificationRecipients NotificationRecipient[]
  inboundChannelMessages InboundChannelMessage[]
  archivedInvoices       ArchivedInvoice[]
  paymentObligations      PaymentObligation[]
  obligationOccurrences   ObligationOccurrence[]
  obligationDecisions     ObligationLineDecision[]
  obligationRequests      ObligationApprovalRequest[]
  obligationEvents        ObligationScheduleEvent[]
  obligationPayments      ObligationSimulatedPayment[]
  obligationConfirmations ObligationConfirmation[]
  demoClock               DemoClock?

  // Vertical A
  contracts            Contract[]
  contractFlowVersions ContractFlowVersion[]

  @@map("organizations")
}

model User {
  id          String   @id
  email       String
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships      OrganizationMembership[]
  gmailConnections GmailConnection[]

  @@index([email])
  @@map("users")
}

/// Relación User ↔ Organization. Un usuario solo opera dentro de orgs a las que pertenece.
model OrganizationMembership {
  userId         String         @map("user_id")
  organizationId String         @map("organization_id")
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  approvalPermission ApprovalPermission?

  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Vertical B — Payment Autopilot (docs/plans/developer-b-payment-decisions.md)
// Importes: unidades menores enteras (int4, máx. ~21.4M USD); moneda ISO 4217.
// Actores (`*By`, `actorId`): Clerk `user_...` como texto, sin FK, para que la
// auditoría sobreviva a la baja de un usuario.
//
// Garantías en SQL: Prisma 6 no expresa CHECK, índices únicos parciales ni
// triggers, así que viven en la migración `20261017163245_add_payment_autopilot_tables`
// y se documentan con `@db-guarantee` en cada modelo. Prisma las ignora al
// comparar (no las borra), pero si cambias un modelo marcado, actualiza su SQL.
// ---------------------------------------------------------------------------

enum PaymentAuthorizationScope {
  one_time
  recurring
}

enum PaymentAuthorizationStatus {
  active
  revoked
  consumed
}

enum PaymentFrequency {
  weekly
  monthly
  quarterly
  yearly
}

enum PaymentDecisionOutcome {
  approved
  blocked
  requires_approval
}

enum PaymentDecisionSource {
  automatic
  human
}

enum ApprovalRequestStatus {
  pending
  approved
  rejected
  cancelled
}

/// Catálogo de proveedores. Estar en el catálogo NO implica autorización.
model Supplier {
  id                    String   @id @default(cuid())
  organizationId        String   @map("organization_id")
  name                  String
  normalizedName        String   @map("normalized_name")
  beneficiaryAccountRef String?  @map("beneficiary_account_ref") // informativa; la autorización manda
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization     Organization           @relation(fields: [organizationId], references: [id])
  authorizations   PaymentAuthorization[]
  decisions        PaymentDecision[]
  bankTransactions BankTransaction[]
  contracts        Contract[]
  invoices         Invoice[]

  @@unique([organizationId, normalizedName])
  @@map("suppliers")
}

/// Política versionada. Cada cambio crea una versión nueva; nunca se edita una existente.
/// @db-guarantee CHECK payment_policies_amounts_check: version > 0, límite y presupuesto >= 0, moneda ^[A-Z]{3}$.
model PaymentPolicy {
  id                     String   @id @default(cuid())
  organizationId         String   @map("organization_id")
  version                Int
  autoApprovalLimitMinor Int      @map("auto_approval_limit_minor")
  monthlyBudgetMinor     Int      @map("monthly_budget_minor")
  currency               String   @db.Char(3)
  effectiveFrom          DateTime @map("effective_from") @db.Timestamptz(6)
  createdBy              String   @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, version])
  @@map("payment_policies")
}

/// Autorización explícita otorgada por una persona. Cubre una factura solo si coinciden
/// proveedor, cuenta, moneda, monto máximo, alcance y vigencia.
/// @db-guarantee CHECK payment_authorizations_terms_check: monto máximo > 0, moneda ^[A-Z]{3}$,
///   validUntil >= validFrom, frecuencia obligatoria si recurring y null si one_time.
model PaymentAuthorization {
  id                      String                     @id @default(cuid())
  organizationId          String                     @map("organization_id")
  supplierId              String                     @map("supplier_id")
  beneficiaryAccountRef   String                     @map("beneficiary_account_ref")
  currency                String                     @db.Char(3)
  maxAmountMinor          Int                        @map("max_amount_minor")
  scope                   PaymentAuthorizationScope
  frequency               PaymentFrequency? // obligatoria si scope = recurring
  validFrom               DateTime                   @map("valid_from") @db.Date
  validUntil              DateTime                   @map("valid_until") @db.Date
  status                  PaymentAuthorizationStatus @default(active)
  authorizedBy            String                     @map("authorized_by")
  sourceApprovalRequestId String?                    @map("source_approval_request_id")
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt               DateTime?                  @map("revoked_at") @db.Timestamptz(6)
  revokedBy               String?                    @map("revoked_by")

  organization Organization      @relation(fields: [organizationId], references: [id])
  supplier     Supplier          @relation(fields: [supplierId], references: [id])
  decisions    PaymentDecision[]

  @@index([organizationId, supplierId, status])
  @@map("payment_authorizations")
}

/// Permisos de pago por usuario. Sin fila = sin permisos. Solo `admin` los edita.
/// @db-guarantee CHECK approval_permissions_limit_check: si canApprove, approvalLimitMinor no null y > 0;
///   si no, approvalLimitMinor null (no hay aprobadores ilimitados).
model ApprovalPermission {
  userId             String   @map("user_id")
  organizationId     String   @map("organization_id")
  canApprove         Boolean  @default(false) @map("can_approve")
  approvalLimitMinor Int?     @map("approval_limit_minor") // obligatorio si canApprove
  canManagePolicies  Boolean  @default(false) @map("can_manage_policies")
  grantedBy          String   @map("granted_by")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership OrganizationMembership @relation(fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade)

  @@id([userId, organizationId])
  @@map("approval_permissions")
}

/// Cada PaymentDecision validada. Solo inserción: una reevaluación crea otra fila.
/// @db-guarantee CHECK payment_decisions_actor_check: automatic => actorId null;
///   human => actorId y approvalRequestId no null.
/// @db-guarantee CHECK payment_decisions_approved_check: approved => policyVersion, amountMinor y currency no null.
/// @db-guarantee UNIQUE parcial payment_decisions_one_approved_per_invoice: (organizationId, invoiceId)
///   WHERE decision = 'approved' — una factura se aprueba y reserva presupuesto a lo sumo una vez.
/// @db-guarantee TRIGGER payment_decisions_append_only: rechaza UPDATE y DELETE.
/// @db-guarantee CHECK payment_decisions_authorization_check: authorizationId solo en decisiones approved
///   (migración 20261017195842_add_decision_invoice_date_and_authorization).
model PaymentDecision {
  id                String                 @id @default(cuid())
  organizationId    String                 @map("organization_id")
  invoiceId         String                 @map("invoice_id") // FK pendiente hasta que A cree `invoices`
  supplierId        String?                @map("supplier_id")
  invoiceNumber     String?                @map("invoice_number")
  amountMinor       Int?                   @map("amount_minor")
  currency          String?                @db.Char(3)
  decision          PaymentDecisionOutcome
  decisionSource    PaymentDecisionSource  @map("decision_source")
  reasonCodes       Json                   @map("reason_codes")
  rulesEvaluated    Json                   @map("rules_evaluated")
  payload           Json // PaymentDecision completa validada por Zod
  policyVersion     Int?                   @map("policy_version")
  actorId           String?                @map("actor_id")
  approvalRequestId String?                @map("approval_request_id") // solicitud que resuelve (decisión humana)
  invoiceDate       DateTime?              @map("invoice_date") @db.Date // para duplicados sospechosos
  authorizationId   String?                @map("authorization_id") // autorización que cubrió una aprobación
  invoiceContext    Json?                  @map("invoice_context") // InvoiceContext evaluado (evidencia y reevaluación)
  evaluatedAt       DateTime               @map("evaluated_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  organization      Organization          @relation(fields: [organizationId], references: [id])
  supplier          Supplier?             @relation(fields: [supplierId], references: [id])
  authorization     PaymentAuthorization? @relation(fields: [authorizationId], references: [id])
  resolvesRequest   ApprovalRequest?      @relation("ApprovalResolution", fields: [approvalRequestId], references: [id])
  triggeredApproval ApprovalRequest?      @relation("ApprovalTrigger")

  @@index([organizationId, invoiceId])
  @@index([organizationId, supplierId, invoiceNumber])
  @@index([organizationId, decision, evaluatedAt])
  @@index([authorizationId, decision, invoiceDate])
  @@map("payment_decisions")
}

/// Bandeja de intervención humana.
/// @db-guarantee UNIQUE parcial approval_requests_one_pending_per_invoice: (organizationId, invoiceId)
///   WHERE status = 'pending'.
model ApprovalRequest {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  invoiceId      String                @map("invoice_id")
  decisionId     String                @unique @map("decision_id") // decisión que escaló
  status         ApprovalRequestStatus @default(pending)
  requestedAt    DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedAt     DateTime?             @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?               @map("resolved_by")
  comment        String?

  organization Organization      @relation(fields: [organizationId], references: [id])
  decision     PaymentDecision   @relation("ApprovalTrigger", fields: [decisionId], references: [id])
  resolutions  PaymentDecision[] @relation("ApprovalResolution")

  @@index([organizationId, status, requestedAt])
  @@map("approval_requests")
}

/// Lote de importación CSV.
model BankImportBatch {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  fileName       String   @map("file_name")
  rowCount       Int      @map("row_count")
  importedBy     String   @map("imported_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id])
  transactions BankTransaction[]

  @@index([organizationId, createdAt])
  @@map("bank_import_batches")
}

/// Movimiento ficticio importado de CSV. Historial, no autorización ni presupuesto.
model BankTransaction {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  importBatchId  String   @map("import_batch_id")
  supplierId     String?  @map("supplier_id")
  postedOn       DateTime @map("posted_on") @db.Date
  amountMinor    Int      @map("amount_minor") // con signo: negativo = salida
  currency       String   @db.Char(3)
  description    String
  externalRef    String?  @map("external_ref")
  fingerprint    String // hash de fecha + monto + descripción, para omitir repetidos
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id])
  importBatch  BankImportBatch @relation(fields: [importBatchId], references: [id])
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])

  @@unique([organizationId, fingerprint])
  @@unique([organizationId, externalRef])
  @@index([organizationId, supplierId, postedOn])
  @@map("bank_transactions")
}

/// Rastro append-only. actorId null = sistema.
/// @db-guarantee TRIGGER audit_events_append_only: rechaza UPDATE y DELETE.
model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  eventType      String   @map("event_type")
  actorId        String?  @map("actor_id")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

enum GmailConnectionStatus {
  pending
  active
  failed
  expired
  revoked
}

enum GmailInboundProcessingStatus {
  received
  processing
  processed
  failed
  ignored
}

/// Buzón Gmail de la organización. Tokens en Composio; aquí solo ids y estado.
model GmailConnection {
  id                         String                @id
  organizationId             String                @map("organization_id")
  connectedByUserId          String                @map("connected_by_user_id")
  composioUserId             String                @map("composio_user_id")
  composioConnectedAccountId String                @unique @map("composio_connected_account_id")
  composioAuthConfigId       String                @map("composio_auth_config_id")
  composioTriggerId          String?               @unique @map("composio_trigger_id")
  emailAddress               String?               @unique @map("email_address")
  alias                      String?
  status                     GmailConnectionStatus
  connectedAt                DateTime?             @map("connected_at") @db.Timestamptz(6)
  revokedAt                  DateTime?             @map("revoked_at") @db.Timestamptz(6)
  createdAt                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connectedBy  User                  @relation(fields: [connectedByUserId], references: [id], onDelete: Restrict)
  messages     GmailInboundMessage[]

  @@index([organizationId])
  @@map("gmail_connections")
}

/// Ingesta de un correo. Unicidad por buzón + message id de Gmail.
model GmailInboundMessage {
  id                String                       @id
  organizationId    String                       @map("organization_id")
  gmailConnectionId String                       @map("gmail_connection_id")
  composioEventId   String                       @unique @map("composio_event_id")
  gmailMessageId    String                       @map("gmail_message_id")
  gmailThreadId     String?                      @map("gmail_thread_id")
  sender            String?
  subject           String?
  receivedAt        DateTime                     @map("received_at") @db.Timestamptz(6)
  processingStatus  GmailInboundProcessingStatus @map("processing_status")
  invoiceId         String?                      @map("invoice_id")
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection   GmailConnection      @relation(fields: [gmailConnectionId], references: [id], onDelete: Restrict)
  documents    Document[]
  groups       DocumentGroup[]
  ignoredItems IgnoredInboundItem[]
  invoices     Invoice[]

  @@unique([gmailConnectionId, gmailMessageId])
  @@index([organizationId, receivedAt])
  @@map("gmail_inbound_messages")
}

enum DocumentSource {
  email_body
  invoice_document
}

/// Original privado (cuerpo o adjunto). No implica una decisión de pago.
model Document {
  id                    String         @id
  organizationId        String         @map("organization_id")
  gmailInboundMessageId String         @map("gmail_inbound_message_id")
  fileRef               String         @map("file_ref")
  publicUrl             String         @map("public_url")
  mimeType              String         @map("mime_type")
  sha256                String
  originalFilename      String?        @map("original_filename")
  source                DocumentSource
  byteSize              Int            @map("byte_size")
  receivedAt            DateTime       @map("received_at") @db.Timestamptz(6)
  groupId               String?        @map("group_id")
  groupRole             DocumentRole?  @map("group_role")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inboundMessage GmailInboundMessage @relation(fields: [gmailInboundMessageId], references: [id], onDelete: Restrict)
  group          DocumentGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invoices       Invoice[]

  @@index([organizationId])
  @@index([gmailInboundMessageId])
  @@index([groupId])
  @@map("documents")
}

enum DocumentGroupKind {
  /// Una posible factura: su documento principal y la evidencia de apoyo.
  invoice_candidate
  /// Cuerpo de un correo con varios adjuntos: no se puede atribuir a una sola factura.
  message_context
}

enum DocumentRole {
  primary
  supporting
}

/// Agrupación determinística de los documentos de un correo. No es una autorización.
model DocumentGroup {
  id                    String            @id
  organizationId        String            @map("organization_id")
  gmailInboundMessageId String            @map("gmail_inbound_message_id")
  kind                  DocumentGroupKind
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inboundMessage GmailInboundMessage @relation(fields: [gmailInboundMessageId], references: [id], onDelete: Restrict)
  documents      Document[]
  invoice        Invoice?

  @@index([organizationId])
  @@index([gmailInboundMessageId])
  @@map("document_groups")
}

enum IgnoredItemKind {
  attachment
  message
}

enum IgnoredItemReason {
  unsupported_mime_type
  empty_file
  file_too_large
  missing_content
  duplicate_content
  fetch_failed
  no_usable_content
}

/// Qué se descartó de un correo y por qué. Se regenera en cada intento de descarga.
model IgnoredInboundItem {
  id                    String            @id
  organizationId        String            @map("organization_id")
  gmailInboundMessageId String            @map("gmail_inbound_message_id")
  kind                  IgnoredItemKind
  gmailAttachmentId     String?           @map("gmail_attachment_id")
  filename              String?
  mimeType              String?           @map("mime_type")
  byteSize              Int?              @map("byte_size")
  reason                IgnoredItemReason
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inboundMessage GmailInboundMessage @relation(fields: [gmailInboundMessageId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([gmailInboundMessageId])
  @@map("ignored_inbound_items")
}

// ---------------------------------------------------------------------------
// Vertical A — Contratos (docs/plans/developer-a-invoices.md)
// Registrados a mano en P0. Un contrato es evidencia para comparar facturas;
// NUNCA autoriza un pago (eso solo lo hace PaymentAuthorization).
// ---------------------------------------------------------------------------

enum ContractStatus {
  active
  terminated
}

enum ContractFrequency {
  one_time
  weekly
  monthly
  quarterly
  yearly
}

/// Condiciones acordadas con un proveedor. Se termina, no se borra.
/// @db-guarantee CHECK contracts_terms_check: monto acordado > 0, moneda ^[A-Z]{3}$,
///   validTo null o >= validFrom; terminated <=> terminatedAt y terminatedBy no null.
model Contract {
  id                    String            @id @default(cuid())
  organizationId        String            @map("organization_id")
  supplierId            String            @map("supplier_id")
  status                ContractStatus    @default(active)
  agreedAmountMinor     Int               @map("agreed_amount_minor")
  currency              String            @db.Char(3)
  frequency             ContractFrequency
  validFrom             DateTime          @map("valid_from") @db.Date
  validTo               DateTime?         @map("valid_to") @db.Date // null = sin fecha de fin
  beneficiaryAccountRef String?           @map("beneficiary_account_ref") // referencia enmascarada
  description           String?
  createdBy             String            @map("created_by")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  terminatedAt          DateTime?         @map("terminated_at") @db.Timestamptz(6)
  terminatedBy          String?           @map("terminated_by")

  organization Organization @relation(fields: [organizationId], references: [id])
  supplier     Supplier     @relation(fields: [supplierId], references: [id])

  flowVersions ContractFlowVersion[]

  @@index([organizationId, supplierId, status])
  @@index([organizationId, createdAt])
  @@map("contracts")
}

enum ContractFlowStatus {
  draft
  active
  superseded
}

/// Versión del flujo (grafo de nodos y aristas) que describe cómo se paga un contrato.
/// Un borrador se edita; al activarse queda congelado. Evidencia, nunca autorización.
/// Las columnas planas de Contract son un resumen de la versión activa (monto fijo o tope).
/// @db-guarantee UNIQUE INDEX contract_flow_versions_one_active: una sola versión active por contrato.
/// @db-guarantee UNIQUE INDEX contract_flow_versions_one_draft: un solo borrador por contrato.
/// @db-guarantee TRIGGER contract_flow_versions_frozen: una versión no draft no cambia su grafo,
///   hash ni versión (solo active → superseded) y no se borra.
model ContractFlowVersion {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  contractId     String             @map("contract_id")
  version        Int
  schemaVersion  Int                @default(1) @map("schema_version")
  graph          Json
  graphSha256    String             @map("graph_sha256")
  status         ContractFlowStatus @default(draft)
  createdBy      String             @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedBy    String?            @map("activated_by")
  activatedAt    DateTime?          @map("activated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  contract     Contract     @relation(fields: [contractId], references: [id])

  @@unique([contractId, version])
  @@index([organizationId, contractId, status])
  @@map("contract_flow_versions")
}

// ---------------------------------------------------------------------------
// Facturas (A-01): una por grupo `invoice_candidate` o por carga manual.
// ---------------------------------------------------------------------------

enum InvoiceIntakeSource {
  email
  dashboard
}

// Igual que SupplierMatchStatusSchema (Zod): `matched` identifica, no autoriza.
enum InvoiceSupplierMatch {
  matched
  ambiguous
  not_found
}

enum InvoiceExtractionStatus {
  pending
  processing
  extracted
  failed
}

// receipt: el documento acredita un pago YA hecho (p. ej. cargo automático a tarjeta). No se
// evalúa para pagar; null = fila anterior a la clasificación.
enum InvoiceDocumentKind {
  invoice
  receipt
}

/// Factura recibida. Guarda lo extraído (hechos, no autorización) y el InvoiceContext validado;
/// la decisión vive en payment_decisions (vertical B).
model Invoice {
  id                    String                  @id
  organizationId        String                  @map("organization_id")
  source                InvoiceIntakeSource
  // Idempotencia del correo: un grupo produce a lo sumo una factura. SET NULL para no bloquear
  // el reintento de descarga, que regenera los grupos.
  documentGroupId       String?                 @unique @map("document_group_id")
  gmailInboundMessageId String?                 @map("gmail_inbound_message_id")
  primaryDocumentId     String?                 @map("primary_document_id")
  extractionStatus      InvoiceExtractionStatus @default(pending) @map("extraction_status")
  extractionError       String?                 @map("extraction_error") // etapa y motivo, sin datos de la factura
  supplierId            String?                 @map("supplier_id")
  supplierMatchStatus   InvoiceSupplierMatch?   @map("supplier_match_status")
  name                  String? // nombre extraído (no identifica al proveedor)
  invoiceNumber         String?                 @map("invoice_number")
  amountMinor           Int?                    @map("amount_minor")
  currency              String?                 @db.Char(3)
  invoiceDate           DateTime?               @map("invoice_date") @db.Date
  dueDate               DateTime?               @map("due_date") @db.Date
  contextJson           Json?                   @map("context_json") // InvoiceContext validado
  documentKind          InvoiceDocumentKind?    @map("document_kind")
  paidOn                DateTime?               @map("paid_on") @db.Date // solo recibos
  paymentMethod         String?                 @map("payment_method") // enmascarado, solo recibos
  receivedAt            DateTime                @map("received_at") @db.Timestamptz(6)
  processedAt           DateTime?               @map("processed_at") @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentGroup   DocumentGroup?       @relation(fields: [documentGroupId], references: [id], onDelete: SetNull)
  inboundMessage  GmailInboundMessage? @relation(fields: [gmailInboundMessageId], references: [id], onDelete: SetNull)
  primaryDocument Document?            @relation(fields: [primaryDocumentId], references: [id], onDelete: SetNull)
  supplier        Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([organizationId, receivedAt])
  @@index([organizationId, extractionStatus])
  @@index([organizationId, documentKind, paidOn])
  @@index([gmailInboundMessageId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Notificaciones (WhatsApp / Slack). Los valores guardados van en inglés; el texto que reciben
// las personas va en español (features/notifications/copy.ts y plantillas).
// ---------------------------------------------------------------------------

enum NotificationChannel {
  whatsapp
  slack
  email
}

enum NotificationRecipientStatus {
  active
  disabled
}

enum InboundMessageContext {
  quoted_request // la respuesta cita una solicitud pendiente de la organización
  single_pending // sin cita explícita; hay exactamente una solicitud pendiente (inferencia)
  ambiguous // varias solicitudes pendientes y ninguna citada
  no_open_approvals // no hay solicitudes pendientes
  request_not_pending // cita una solicitud inexistente, ajena o ya resuelta
}

/// Destinatario de notificaciones (p. ej. administrador). Su dirección identifica a la organización
/// de un mensaje entrante; una dirección desconocida o deshabilitada se omite.
/// @db-guarantee UNIQUE (channel, address): una dirección pertenece a una sola organización.
/// @db-guarantee CHECK notification_recipients_whatsapp_address_check: WhatsApp = E.164 solo dígitos.
model NotificationRecipient {
  id             String                      @id
  organizationId String                      @map("organization_id")
  channel        NotificationChannel
  address        String // WhatsApp: E.164 solo dígitos, sin '+'
  status         NotificationRecipientStatus @default(active)
  verifiedAt     DateTime?                   @map("verified_at") @db.Timestamptz(6)
  createdBy      String                      @map("created_by")
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  messages     InboundChannelMessage[]

  @@unique([channel, address])
  @@index([organizationId])
  @@map("notification_recipients")
}

/// Mensaje entrante de un canal de notificación. Evidencia NO confiable: nunca resuelve una
/// aprobación. `eventKey` único = idempotencia frente a reintentos del proveedor.
model InboundChannelMessage {
  id                       String                @id
  organizationId           String                @map("organization_id")
  recipientId              String                @map("recipient_id")
  channel                  NotificationChannel
  eventKey                 String                @unique @map("event_key")
  providerMessageId        String                @map("provider_message_id")
  replyToProviderMessageId String?               @map("reply_to_provider_message_id")
  text                     String?
  buttonPayload            String?               @map("button_payload")
  claimedAction            String?               @map("claimed_action") // pista del botón (pay | reject | details); no autoriza
  context                  InboundMessageContext
  approvalRequestId        String?               @map("approval_request_id")
  receivedAt               DateTime              @map("received_at") @db.Timestamptz(6)
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipient    NotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([organizationId, receivedAt])
  @@index([approvalRequestId])
  @@map("inbound_channel_messages")
}

// ---------------------------------------------------------------------------
// Facturas archivadas: ocultas de listados, gráficos y aprobaciones sin borrar nada.
// Por id de factura (también las del simulador, que no tienen fila en `invoices`). El motor de
// decisiones NO las excluye: duplicados y presupuesto siguen contándolas (más estricto, nunca menos).
// Desarchivar = borrar la fila de esta tabla.
// ---------------------------------------------------------------------------

model ArchivedInvoice {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  invoiceId      String   @map("invoice_id")
  reason         String
  archivedBy     String?  @map("archived_by") // null = script de mantenimiento
  archivedAt     DateTime @default(now()) @map("archived_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, invoiceId])
  @@map("archived_invoices")
}

// ---------------------------------------------------------------------------
// Core proactivo: obligaciones recurrentes (nómina) — platform-core
// Importes en unidades menores como BigInt: una nómina en COP supera el rango de Int4.
// ---------------------------------------------------------------------------

enum ObligationKind {
  payroll
  fiscal
}

enum ObligationStatus {
  draft
  active
  paused
}

enum OccurrenceStatus {
  scheduled
  collecting_evidence
  evaluated
  in_approval
  ready_to_execute
  simulated_executed
  held
  failed
  cancelled
}

/// Plantilla versionada de una obligación recurrente. Una versión no se edita: un cambio crea otra fila.
/// Una plantilla no activa nunca opera en automático (la regla `obligacion_autorizada` escala).
model PaymentObligation {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  obligationId   String           @map("obligation_id") // id estable de la obligación entre versiones
  version        Int
  kind           ObligationKind
  status         ObligationStatus @default(draft)
  template       Json // ObligationTemplate validada con Zod
  schedule       Json // Schedule (calendario de pago) validado con Zod
  createdBy      String           @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedBy    String?          @map("activated_by")
  activatedAt    DateTime?        @map("activated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, obligationId, version])
  @@index([organizationId, status])
  @@map("payment_obligations")
}

/// Una obligación en un periodo concreto. Única por (organización, obligación, inicio de periodo): idempotencia del tick.
model ObligationOccurrence {
  id                String           @id @default(cuid())
  organizationId    String           @map("organization_id")
  obligationId      String           @map("obligation_id")
  obligationVersion Int              @map("obligation_version")
  periodStart       DateTime         @map("period_start") @db.Date
  periodEnd         DateTime         @map("period_end") @db.Date
  dueDate           DateTime         @map("due_date") @db.Date
  status            OccurrenceStatus @default(scheduled)
  asOf              DateTime?        @map("as_of") @db.Timestamptz(6) // instante de la última evaluación
  evidenceSha       String?          @map("evidence_sha")
  evaluation        Json? // resultado de la última evaluación (conteos, hallazgos de corrida)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization                 @relation(fields: [organizationId], references: [id])
  decisions    ObligationLineDecision[]
  requests     ObligationApprovalRequest[]
  payments     ObligationSimulatedPayment[]

  @@unique([organizationId, obligationId, periodStart])
  @@index([organizationId, status, dueDate])
  @@map("obligation_occurrences")
}

/// Decisión sobre una línea de pago. Solo inserción (trigger): una reevaluación o una resolución humana crean otra fila.
model ObligationLineDecision {
  id              String                 @id @default(cuid())
  organizationId  String                 @map("organization_id")
  occurrenceId    String                 @map("occurrence_id")
  lineId          String                 @map("line_id")
  counterpartyRef String                 @map("counterparty_ref")
  displayName     String                 @map("display_name")
  lineType        String                 @map("line_type")
  amountMinor     BigInt?                @map("amount_minor")
  currency        String?                @db.Char(3)
  decision        PaymentDecisionOutcome
  decisionSource  PaymentDecisionSource  @map("decision_source")
  reasonCodes     Json                   @map("reason_codes")
  rules           Json
  decisionKey     String                 @map("decision_key") // occurrenceId + lineId + hash de la evidencia
  evidenceSha     String                 @map("evidence_sha")
  actorId         String?                @map("actor_id")
  comment         String?
  evaluatedAt     DateTime               @map("evaluated_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization               @relation(fields: [organizationId], references: [id])
  occurrence   ObligationOccurrence       @relation(fields: [occurrenceId], references: [id])
  request      ObligationApprovalRequest? @relation("LineApprovalTrigger")

  @@index([organizationId, occurrenceId, lineId, createdAt])
  @@index([organizationId, counterpartyRef, createdAt])
  @@map("obligation_line_decisions")
}

/// Bandeja humana de una línea que escaló. Una pendiente por línea (índice parcial en la migración).
model ObligationApprovalRequest {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  occurrenceId   String                @map("occurrence_id")
  lineId         String                @map("line_id")
  decisionId     String                @unique @map("decision_id") // decisión que escaló
  status         ApprovalRequestStatus @default(pending)
  requestedAt    DateTime              @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedAt     DateTime?             @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?               @map("resolved_by")
  comment        String?

  organization Organization           @relation(fields: [organizationId], references: [id])
  occurrence   ObligationOccurrence   @relation(fields: [occurrenceId], references: [id])
  decision     ObligationLineDecision @relation("LineApprovalTrigger", fields: [decisionId], references: [id])

  @@index([organizationId, status, requestedAt])
  @@map("obligation_approval_requests")
}

/// Fase del calendario ya reclamada por un tick. El índice único hace idempotente al cron: reclamar dos veces es imposible.
model ObligationScheduleEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  obligationId   String   @map("obligation_id")
  periodStart    DateTime @map("period_start") @db.Date
  phase          String // prepare | alert_early | alert_urgent | execute
  claimedAt      DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)
  asOf           DateTime @map("as_of") @db.Timestamptz(6) // instante lógico del tick (reloj de demo o real)
  result         Json?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, obligationId, periodStart, phase])
  @@map("obligation_schedule_events")
}

/// Pago SIMULADO de una línea: a lo sumo uno por línea de una ocurrencia. No mueve dinero.
model ObligationSimulatedPayment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  occurrenceId   String   @map("occurrence_id")
  lineId         String   @map("line_id")
  decisionId     String   @map("decision_id")
  amountMinor    BigInt   @map("amount_minor")
  currency       String   @db.Char(3)
  executedAt     DateTime @map("executed_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id])
  occurrence   ObligationOccurrence @relation(fields: [occurrenceId], references: [id])

  @@unique([occurrenceId, lineId])
  @@map("obligation_simulated_payments")
}

/// Último monto y última cuenta CONFIRMADOS por contraparte (lo que leen la regla de variación y la de cuenta estable).
/// Lo escribe una aprobación (automática ejecutada o humana), nunca el historial por sí solo.
model ObligationConfirmation {
  id                   String   @id @default(cuid())
  organizationId       String   @map("organization_id")
  obligationId         String   @map("obligation_id")
  counterpartyRef      String   @map("counterparty_ref")
  beneficiaryReference String?  @map("beneficiary_reference") // enmascarada ****1234
  amountMinor          BigInt   @map("amount_minor")
  confirmedPeriod      DateTime @map("confirmed_period") @db.Date
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, obligationId, counterpartyRef])
  @@map("obligation_confirmations")
}

/// Reloj de demo por organización. Solo se usa con PACTA_SHOW_DEV_TOOLS=true; sin fila rige el reloj del sistema.
model DemoClock {
  organizationId String   @id @map("organization_id")
  now            DateTime @db.Timestamptz(6)
  updatedBy      String   @map("updated_by")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("demo_clock")
}
